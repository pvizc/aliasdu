    "@types/node": "^24.19.1",
    "chrome-types": "^0.1.452",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "lucide": "^1.52.0",
    "webextension-polyfill": "file:vendor/webextension-polyfill"
