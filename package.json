  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist extension.zip",
    "package": "pnpm run build && node scripts/package.mjs",
    "firefox": "pnpm run build && web-ext run --source-dir dist",
    "lint:firefox": "pnpm run build && web-ext lint --source-dir dist",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm run build && node --test tests/regression.test.mjs"
  },
  "repository": {
    "type": "git",
